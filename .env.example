# LLM proxy configuration for the agent synthesizer.
# Copy this file to .env and fill in your values.

# Model name served by your proxy (chat/completions).
SYNTHESIZE_MODEL=claude-4.5-opus

# Base URL of the OpenAI/Anthropic-compatible proxy (e.g. a LiteLLM proxy).
SYNTHESIZE_PROXY_BASE_URL=http://localhost:4000

# Embedding model name served by your proxy. Used by the ExplorationManifest to
# embed tool descriptions (a fallback for environments with very many tools).
SYNTHESIZE_EMBEDDING_MODEL=text-embedding-3-large

# Optional. Client surface used to talk to the proxy:
#   anthropic -> native Messages API (ChatAnthropic). Adds Anthropic prompt-cache
#                headers; use when your proxy forwards them to Anthropic.
#   openai    -> OpenAI-compatible Chat Completions (ChatOpenAI, calls <base>/v1).
#                Use this for proxies/gateways that reject the extra
#                `cache_control` field (common error: "cache_control: Extra
#                inputs are not permitted").
# When unset: defaults to `anthropic` for models named `claude-*`, else `openai`.
# SYNTHESIZE_LLM_API=openai

# Optional sampling temperature (float). Defaults to the model's own default.
# SYNTHESIZE_TEMPERATURE=1.0

# Langfuse integration (optional — runs push to Langfuse datasets if set).
# Install the langfuse extra first: uv sync --all-extras
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
