{
  "description": "Reference mapping from original airline-domain names to generic de-identified names used in the generic environment.",

  "column_renames": {
    "user_id": "property_id",
    "origin": "object_a_property_1",
    "destination": "object_a_property_2",
    "departure_time": "scheduled_property_c",
    "arrival_time": "scheduled_property_d",
    "source": "property_i",
    "brand": "property_j",
    "last_four": "property_k",
    "date": "property_l",
    "dob": "property_m",
    "first_name": "property_n",
    "last_name": "property_o",
    "email": "property_p",
    "membership": "property_q",
    "address1": "property_r",
    "address2": "property_s",
    "city": "property_t",
    "state": "property_u",
    "country": "property_v",
    "zip": "property_w",
    "cabin_class": "property_e",
    "checked_bags": "property_f",
    "paid_bags": "property_h",
    "insurance": "property_g",
    "price": "property_b",
    "available_seats": "property_a"
  },

  "column_semantics": {
    "property_id": "primary key for the object_fs table (user identifier)",
    "object_a_property_1": "origin location code",
    "object_a_property_2": "destination location code",
    "scheduled_property_c": "scheduled departure time (HH:MM:SS)",
    "scheduled_property_d": "scheduled arrival time (HH:MM:SS, may include +1 for next-day)",
    "property_i": "payment method type (i_a=credit_card, i_b=gift_card, i_c=certificate)",
    "property_j": "credit card brand (value_a=visa, value_b=mastercard, value_c=amex)",
    "property_k": "last four digits of credit card",
    "property_l": "calendar date (YYYY-MM-DD)",
    "property_m": "date of birth (YYYY-MM-DD)",
    "property_n": "first name",
    "property_o": "last name",
    "property_p": "email address",
    "property_q": "membership tier (value_g=gold, value_s=silver, value_r=regular)",
    "property_r": "street address line 1",
    "property_s": "street address line 2 (nullable)",
    "property_t": "city",
    "property_u": "state",
    "property_v": "country",
    "property_w": "zip code",
    "property_e": "cabin class (type_b=business, type_a=economy, type_c=basic_economy)",
    "property_f": "total checked bag count",
    "property_h": "non-free (paid) checked bag count",
    "property_g": "travel insurance flag (yes/no)",
    "property_b": "price per passenger",
    "property_a": "available seat count",
    "property_a_type_b": "available business class seats",
    "property_a_type_a": "available economy seats",
    "property_a_type_c": "available basic economy seats",
    "property_b_type_b": "business class price",
    "property_b_type_a": "economy price",
    "property_b_type_c": "basic economy price",
    "estimated_property_c": "estimated departure time (when delayed/in-flight)",
    "estimated_property_d": "estimated arrival time",
    "actual_property_c": "actual departure time",
    "actual_property_d": "actual arrival time"
  },

  "table_renames": {
    "flights": "object_bs",
    "flight_dates": "object_b_dates",
    "object_b_dates": "object_b_property_ls",
    "reservations": "object_cs",
    "reservation_flights": "object_c_object_bs",
    "passengers": "object_c_object_ds",
    "reservation_payments": "object_c_object_es",
    "payment_methods": "object_es",
    "saved_passengers": "saved_object_ds",
    "users": "object_fs"
  },

  "entity_names": {
    "object_a": "location (airport/city)",
    "object_b": "scheduled route instance (flight)",
    "object_c": "booking / reservation",
    "object_d": "traveler / passenger",
    "object_e": "payment method",
    "object_f": "user / account holder"
  },

  "api_file_renames": {
    "flights.py": "f.py",
    "reservations.py": "r.py",
    "users.py": "u.py",
    "payments.py": "p.py"
